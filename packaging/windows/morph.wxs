<!-- Morph's Windows installer (WiX Toolset v5): morph.exe in Program Files,
     a Start menu shortcut, upgrades in place. Built by scripts/windows-dist.ps1:
       wix build packaging/windows/morph.wxs -arch x64 -d Version=0.2.0.8 -d Source=<dir> -o morph.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Morph" Manufacturer="WeirdBrains" Version="$(var.Version)"
           UpgradeCode="e7bc4da6-f255-4f15-a508-d868900a2c3f" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Morph is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="MorphIcon" SourceFile="$(var.Source)\Morph.ico" />
    <Property Id="ARPPRODUCTICON" Value="MorphIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/WeirdBrains/morph" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Morph">
        <Component Id="MorphExe" Guid="*">
          <File Id="MorphExeFile" Source="$(var.Source)\morph.exe" KeyPath="yes" />
        </Component>
        <!-- One file a component, so WiX can derive each component's GUID. -->
        <Component Id="MorphLicense" Guid="*">
          <File Source="$(var.Source)\LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="MorphReadme" Guid="*">
          <File Source="$(var.Source)\README.md" KeyPath="yes" />
        </Component>
        <Component Id="MorphIconFile" Guid="*">
          <File Source="$(var.Source)\Morph.ico" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="MorphShortcut" Guid="*">
        <Shortcut Id="MorphStartMenu" Name="Morph" Description="Morph browser"
                  Target="[INSTALLFOLDER]morph.exe" WorkingDirectory="INSTALLFOLDER" Icon="MorphIcon" />
        <RegistryValue Root="HKCU" Key="Software\WeirdBrains\Morph" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Morph">
      <ComponentRef Id="MorphExe" />
      <ComponentRef Id="MorphLicense" />
      <ComponentRef Id="MorphReadme" />
      <ComponentRef Id="MorphIconFile" />
      <ComponentRef Id="MorphShortcut" />
    </Feature>
  </Package>
</Wix>
