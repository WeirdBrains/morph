# Maintainer: m3talsmith <m3talsmith@gmail.com>
# Binary package: installs the prebuilt GPUI desktop shell attached to a
# GitHub pre-release built from main (morph-<ver>-<arch>-unknown-linux-gnu.tar.gz from
# scripts/linux-dist.sh). No Rust needed, but the release must exist and be
# downloadable (public repo). The upstream tarball is not code-signed; this
# package is likewise unsigned. To build from a checkout, see ../morph.
pkgname=morph-bin
pkgver=0.2.0alpha3
# pacman sorts 0.2.0alpha2 before 0.2.0; the release tag is v0.2.0-alpha.2.
_ver=0.2.0-alpha.3
pkgrel=1
pkgdesc="Distributed web browser with local AI (GPUI desktop shell), prebuilt"
arch=('x86_64')
url="https://github.com/WeirdBrains/morph"
license=('BSD-3-Clause')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'libxkbcommon-x11' 'libxcb' 'vulkan-icd-loader'
         'fontconfig' 'freetype2' 'openssl' 'hicolor-icon-theme' 'glibc' 'gcc-libs')
optdepends=('vulkan-driver: GPU rendering (mesa or the vendor driver)')
provides=('morph')
conflicts=('morph')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$_ver/morph-$_ver-x86_64-unknown-linux-gnu.tar.gz")
# From the release's SHA256SUMS.
sha256sums_x86_64=('ee757d700b7b9564da5c660aedc205e7ee9d4f09f9dce3ad391fa78a4eb0beb9')

package() {
  local bundle="$srcdir/morph-$_ver-$CARCH-unknown-linux-gnu"
  test -x "$bundle/bin/morph"
  install -Dm755 "$bundle/bin/morph" "$pkgdir/usr/bin/morph"
  cp -a "$bundle/share" "$pkgdir/usr/"
  install -Dm644 "$bundle/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$bundle/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
