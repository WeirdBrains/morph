pkgbase = morph
	pkgdesc = Distributed web browser with local AI (GPUI desktop shell)
	pkgver = 0.2.0alpha11
	pkgrel = 1
	url = https://github.com/WeirdBrains/morph
	arch = x86_64
	arch = aarch64
	license = BSD-3-Clause
	makedepends = cargo
	makedepends = git
	makedepends = clang
	makedepends = cmake
	makedepends = pkgconf
	makedepends = python
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = glib2
	depends = libxkbcommon-x11
	depends = libxcb
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = freetype2
	depends = openssl
	depends = hicolor-icon-theme
	depends = glibc
	depends = gcc-libs
	optdepends = vulkan-driver: GPU rendering (mesa or the vendor driver)
	optdepends = gst-plugins-bad: VA-API video decoding (the va plugin)
	options = !lto
	options = !debug

pkgname = morph
